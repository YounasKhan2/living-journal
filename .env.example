# Public canonical origin used for metadata/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection used by Prisma CLI and the server-only Prisma client.
# Docker exposes the project database on host port 5433 to avoid collisions with local PostgreSQL installations.
DATABASE_URL=postgresql://living_journal:living_journal@localhost:5433/living_journal?schema=public

# Redis is server-only infrastructure for durable BullMQ jobs.
# Docker exposes Redis on host port 6380 to reduce collisions with an existing local Redis service.
REDIS_URL=redis://localhost:6380
