generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthAuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  SESSION_REVOKED
}

enum PostStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String
  passwordHash     String
  role             UserRole       @default(EDITOR)
  status           UserStatus     @default(ACTIVE)
  sessions         Session[]
  authAudit        AuthAudit[]
  postsCreated     Post[]         @relation("PostCreatedBy")
  postsUpdated     Post[]         @relation("PostUpdatedBy")
  revisionsCreated PostRevision[] @relation("RevisionCreatedBy")
  mediaCreated     MediaAsset[]   @relation("MediaCreatedBy")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuthAudit {
  id             String         @id @default(cuid())
  event          AuthAuditEvent
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifierHash String?
  networkHash    String?
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([event, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model MediaAsset {
  id          String   @id @default(cuid())
  provider    String
  storageKey  String   @unique
  url         String
  mimeType    String
  bytes       Int?
  width       Int?
  height      Int?
  altText     String
  attribution String?
  createdById String
  createdBy   User     @relation("MediaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  coverPosts  Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  dek             String
  body            Json
  authorName      String
  readTime        String
  status          PostStatus     @default(DRAFT)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImageUrl   String?
  coverMediaId    String?
  coverMedia      MediaAsset?    @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  featured        Boolean        @default(false)
  trending        Boolean        @default(false)
  seoTitle        String?
  metaDescription String?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdById     String
  updatedById     String
  createdBy       User           @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User           @relation("PostUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  revisions       PostRevision[]
  tags            PostTag[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([featured, status])
  @@index([trending, status])
}

model PostRevision {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  createdById String
  createdBy   User     @relation("RevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@unique([postId, version])
  @@index([postId, createdAt])
}
