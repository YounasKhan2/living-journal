{
  "name": "living-journal",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "verify": "npm run db:validate && npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.58.5",
    "gsap": "^3.13.0",
    "ioredis": "^5.7.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "phosphor-react": "^1.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "dotenv": "^17.2.2",
    "eslint": "9.35.0",
    "eslint-config-next": "16.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "description": "Human-led, AI-assisted editorial technology publication"
}
